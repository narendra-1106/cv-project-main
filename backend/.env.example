# ==============================================================================
# LUXVISION AI — Backend Environment Configuration Template
# Copy this file to .env and customize values as appropriate.
# ==============================================================================

# Server Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="LUXVISION AI Backend"
API_V1_PREFIX="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY="replace_with_a_secure_random_secret_key"

# CORS: Allowed origins for frontend clients (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Supabase PostgreSQL Database & Storage
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/luxvision"

# Storage Bucket Names
SUPABASE_RAW_BUCKET="raw-images"
SUPABASE_ENHANCED_BUCKET="enhanced-images"
SUPABASE_EXPORTS_BUCKET="benchmark-exports"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# AI / ML Settings
DEVICE="cuda"
TORCH_PRECISION="fp16"
YOLO_WEIGHTS_PATH="app/ml/weights/yolo11n-exdark.pt"
ZERO_DCE_WEIGHTS_PATH="app/ml/weights/zero_dce.pth"
RETINEXFORMER_WEIGHTS_PATH="app/ml/weights/retinexformer.pth"

# Fixed Research Hyperparameters
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_INPUT_SIZE=640

