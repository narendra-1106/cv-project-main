# ==============================================================================
# LUXVISION AI — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_NAME="LUXVISION AI"
API_V1_PREFIX="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY="replace_with_a_secure_random_secret_key_for_jwt_and_sessions"

# CORS: Allowed origins for frontend clients (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, AUTH, STORAGE)
# ------------------------------------------------------------------------------
# Find these in your Supabase Project Settings -> API / Database
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# PostgreSQL connection string (Supabase Settings -> Database -> Connection String -> URI)
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/luxvision"

# Supabase Storage Bucket Names
SUPABASE_RAW_BUCKET="raw-images"
SUPABASE_ENHANCED_BUCKET="enhanced-images"
SUPABASE_EXPORTS_BUCKET="benchmark-exports"

# ------------------------------------------------------------------------------
# 3. REDIS & CELERY (ASYNC TASK QUEUE)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 4. AI / ML ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Device execution mode: "cuda" (for NVIDIA GPU) or "cpu"
DEVICE="cuda"

# Precision mode: "fp16" (faster on modern GPUs) or "fp32" (default for CPU)
TORCH_PRECISION="fp16"

# Model Weight File Paths
YOLO_WEIGHTS_PATH="backend/app/ml/weights/yolo11n-exdark.pt"
ZERO_DCE_WEIGHTS_PATH="backend/app/ml/weights/zero_dce.pth"
RETINEXFORMER_WEIGHTS_PATH="backend/app/ml/weights/retinexformer.pth"

# Fixed Research Inference Hyperparameters (Must remain uniform across all conditions)
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_INPUT_SIZE=640

# CLAHE Hyperparameters
CLAHE_CLIP_LIMIT=3.0
CLAHE_TILE_GRID_SIZE=8

# ------------------------------------------------------------------------------
# 5. FRONTEND VITE ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# (In frontend/.env, Vite requires variables to be prefixed with VITE_)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

